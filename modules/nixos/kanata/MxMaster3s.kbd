(defsrc mfwd mlft mrgt mmid mwl mwr)

(defvirtualkeys
  meta    lmet
  to-base (layer-switch base)
)

(defalias
  ;; self-releasing Super: restarts on each use, drops 1 s after the last
  sup (hold-for-duration 800 meta)
  ;; tap: enter layer, leave after idle
  hs  (multi (layer-switch hs) (on-idle 800 tap-vkey to-base))
  ;; hold: Super while held
  msp (tap-hold-press 0 170 @hs lmet)
)

(deflayer base @msp mlft mrgt mmid use-defsrc use-defsrc)
(deflayer hs   @msp mlft mrgt mmid
  (multi @sup use-defsrc) (multi @sup use-defsrc))
